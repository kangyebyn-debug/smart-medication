# 공공데이터포털 API 키 (https://www.data.go.kr)
# 이 파일을 복사해서 .env 로 저장한 뒤 키 값을 채워넣으세요.
# .env 파일은 절대 커밋하지 마세요.

SERVICE_KEY=

# Supabase (Phase 2: 계정/DB)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Gemini API (Phase 3: 등록된 약의 실제 DUR 조회 결과만 설명)
# Google AI Studio에서 직접 발급: https://aistudio.google.com
# 무료 티어에는 민감·개인정보를 보내지 마세요. 가상 테스트 데이터만 사용합니다.
# https://ai.google.dev/gemini-api/terms#unpaid-services
GEMINI_API_KEY=
# 선택: 비워두면 gemini-3.5-flash-lite (공식 모델/무료 티어 확인: 2026-11-26)
GEMINI_MODEL=
